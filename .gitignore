# ==============================================================================
# KillCode Whitelist .gitignore
# Only allow explicitly permitted files and directories to be tracked
# ==============================================================================

# Ignore all files and directories at root by default
/*

# ------------------------------------------------------------------------------
# Whitelisted Root Files
# ------------------------------------------------------------------------------
!.gitignore
!PRIVACY.md
!Project-KillCode.js
!README.md
!SECURITY.md
!cookie.examples.txt
!kill.txt
!skill.md
!skillrack-solver-skill.md

# ------------------------------------------------------------------------------
# Whitelisted Directories
# ------------------------------------------------------------------------------
!assets/
!chrome-extension/
!skillrack_scraper/
!skillrack-scraper/
!tools/

# ------------------------------------------------------------------------------
# Universal Ignores (Applies inside whitelisted directories)
# ------------------------------------------------------------------------------
# Sensitive data & credentials - NEVER COMMIT
*cookie.txt
*.cookie
tools/.scratch/
*.env
*.env.*
*.pem
*.key

# Python artifacts & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
env/
venv/

# Caches, test outputs & scraper data
data/
*.db
*.sqlite3
skillrack_questions.db
tmp/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor & OS artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# AI assistant temporary logs & notes
.claude/
*.md.tmp

